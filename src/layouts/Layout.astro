---
import Footer from "../sections/Footer.astro";
import Header from "../sections/Header.astro";
import { ClientRouter } from "astro:transitions"; // Importante
const title =
  Astro.props.title ||
  "ABX STUDIO | Mezcla, Mastering y Beat Making Profesional";
const description =
  Astro.props.description ||
  "ABX STUDIO es un estudio de producción musical especializado en mezcla, mastering y beat making. Beats gratuitos y servicios de producción accesibles.";
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Básico -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO principal -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="ABX STUDIO, producción musical, mezcla, mastering, beat making, beats gratis, estudio de grabación"
    />
    <meta name="author" content="ABX STUDIO" />

    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="yandex" content="index, follow" />

    <link rel="canonical" href="https://tudominio.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="ABX STUDIO | Mezcla, Mastering y Beats"
    />
    <meta
      property="og:description"
      content="Estudio de producción musical. Mezcla, mastering y beat making profesional. Beats gratis disponibles."
    />
    <meta property="og:url" content="https://tudominio.com" />
    <meta property="og:image" content="https://tudominio.com/og-image.jpg" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ABX STUDIO | Producción Musical" />
    <meta
      name="twitter:description"
      content="Mezcla, mastering y beat making profesional. Beats gratuitos y servicios accesibles."
    />
    <meta name="twitter:image" content="https://tudominio.com/og-image.jpg" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&family=Lato:wght@400;700&family=Khula:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />

    <link rel="stylesheet" href="/src/layouts/Global.css" />
    <script src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js"></script>
  </head>
  <body
    class="[&::-webkit-scrollbar]:w-2
  [&::-webkit-scrollbar-track]:rounded-full
  [&::-webkit-scrollbar-track]:bg-gray-100
  [&::-webkit-scrollbar-thumb]:rounded-full
  [&::-webkit-scrollbar-thumb]:bg-cyan-400
  dark:[&::-webkit-scrollbar-track]:bg-black
  dark:[&::-webkit-scrollbar-thumb]:bg-cyan-600"
  >
    <slot />
  </body><script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MusicRecordingStudio",
      "name": "ABX STUDIO",
      "description": "Estudio de producción musical especializado en mezcla, mastering y beat making.",
      "url": "https://abxstudio.es",
      "sameAs": [
        "https://instagram.com/abx_studio",
        "https://soundcloud.com/abx_studio"
      ]
    }
  </script>
</html>
