<style>
  main {
    background: radial-gradient(ellipse at top, #001a1f 0%, #000000 50%, #000000 100%);
  }

  /* Animaciones */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulseSlow {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.1);
    }
  }

  .fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-pulse-slow {
    animation: pulseSlow 8s ease-in-out infinite;
  }

  .process-card {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }

  .track-card {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }

  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }

   
</style>

<script>
  // Intersection Observer para animaciones al scroll
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.opacity = '1';
          (entry.target as HTMLElement).style.transform = 'translateY(0)';
        }
      });
    }, observerOptions);

    const animatedElements = document.querySelectorAll('.fade-in-up, .process-card, .track-card');
    animatedElements.forEach(el => observer.observe(el));
  });

  // Efecto parallax suave en el mouse
  document.addEventListener('mousemove', (e) => {
    const cards = document.querySelectorAll('.process-card, .track-card');
    cards.forEach(card => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      
      const rotateX = (y - centerY) / 20;
      const rotateY = (centerX - x) / 20;
      
      if (x >= 0 && x <= rect.width && y >= 0 && y <= rect.height) {
        (card as HTMLElement).style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
      } else {
        (card as HTMLElement).style.transform = '';
      }
    });
  });
</script>

<iframe
  id="sc-player"
  style="display:none"
  allow="autoplay; encrypted-media" 
  src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/1">
</iframe>

<script is:inline src="https://w.soundcloud.com/player/api.js"></script>

<script>

  declare global {
    interface Window {
      SC: any;
    }
  }
  const initWidget = () => {
    const iframe = document.getElementById('sc-player');
    
    if (typeof (window as any).SC !== 'undefined') {
      const widget = (window as any).SC.Widget(iframe);
      const cards = document.querySelectorAll('.track-card');
      let currentUrl = "";

      cards.forEach(card => {
        const btn = card.querySelector('.play-trigger');
        const url = card.getAttribute('data-soundcloud');

        btn?.addEventListener('click', () => {
          // CASO 1: Si la canción ya es la que está sonando, pausamos/reanudamos
          if (currentUrl === url) {
            widget.toggle();
            return;
          }

          // CASO 2: Es una canción nueva
          // Limpiamos estados de todas las tarjetas
          cards.forEach(c => {
            c.classList.remove('is-playing', 'is-loading');
          });

          card.classList.add('is-loading');
          currentUrl = url || "";

          widget.load(url, {
            auto_play: true,
            callback: () => {
              card.classList.remove('is-loading');
              card.classList.add('is-playing');
            }
          });
        });
      });

      // Escuchar eventos del widget de SoundCloud para actualizar los iconos visualmente
      widget.bind((window as any).SC.Widget.Events.PAUSE, () => {
        document.querySelector('.is-playing')?.classList.remove('is-playing');
      });

      widget.bind((window as any).SC.Widget.Events.PLAY, () => {
        // Buscamos la tarjeta que coincida con la URL actual y le ponemos el estado playing
        widget.getCurrentSound((sound: any) => {
           cards.forEach(c => {
             if(c.getAttribute('data-soundcloud') === sound.permalink_url) {
                c.classList.add('is-playing');
             }
           });
        });
      });

    } else {
      setTimeout(initWidget, 500);
    }
  };

  document.addEventListener('astro:page-load', initWidget);
</script>