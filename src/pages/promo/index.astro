                class="process-card group relative p-6 bg-linear-to-br from-neutral-900/50 to-neutral-900/30 border border-cyan-400/10 rounded-xl hover:border-cyan-400/40 transition-all duration-500 overflow-hidden"
                style={`animation-delay: ${index * 0.1}s;`}
