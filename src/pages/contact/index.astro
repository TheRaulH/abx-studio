---
import Mail from "../../components/icons/mail.astro";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../sections/Footer.astro";
import Header from "../../sections/Header.astro";
import Flashsolid from "../../components/icons/flashsolid.astro";
import FlipCtaCard from "../../components/FlipCtaCard.astro";
---

<Layout title="Contacto | ABX Studio">
  <div class="flex flex-col min-h-screen w-full bg-black">
    <div class="flex-none z-50">
      <Header transition:persist />
    </div>

    <main
      class="flex-1 flex flex-col items-center py-12 px-4 md:py-20 overflow-y-auto"
    >
      <div class="container mx-auto px-4 py-12 max-w-6xl">
        <!-- Header Section -->
        <div class="text-center mb-16">
          <h1 class="text-5xl md:text-6xl font-bold text-white mb-4">
            Conecta con <span class="text-cyan-500">ABX STUDIO</span>
          </h1>
          <p class="text-gray-400 text-lg max-w-2xl mx-auto">
            Somos un estudio de producción musical especializado en llevar tus
            ideas a un nivel profesional. Escríbenos y cuéntanos tu proyecto:
            estamos listos para trabajar contigo.
          </p>
        </div>

        <!-- Social Media Priority Section -->
        <div class="mb-16">
          <div
            class="bg-linear-to-br from-cyan-500/10 to-purple-500/10 backdrop-blur-sm rounded-3xl p-8 md:p-12 border border-cyan-500/30 text-center"
          >
            <h2
              class="text-3xl md:text-4xl font-bold text-white mb-4 flex items-center justify-center gap-3"
            >
              ¡Envíame un DM directo!
              <Mail
                class="w-8 h-8 md:w-10 md:h-10 animate-pulse text-cyan-400"
              />
            </h2>

            <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">
              La forma más rápida de contactarnos es a través de nuestras redes
              sociales. En ABX Studio

              <span class="text-cyan-500 font-semibold"
                >respondemos todos los mensajes</span
              > y analizamos cada proyecto de forma personalizada.
            </p>

            <!-- Social Media Cards -->
            <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
              <!-- Instagram -->
              <a
                href="https://www.instagram.com/abx_studio"
                target="_blank"
                rel="noopener noreferrer"
                class="group bg-black/40 hover:bg-linear-to-br hover:from-purple-600/20 hover:to-pink-600/20 p-8 rounded-2xl border border-gray-800 hover:border-pink-500 transition-all duration-300 transform hover:scale-105"
              >
                <div
                  class="bg-linear-to-br from-purple-500 to-pink-500 p-4 rounded-xl inline-block mb-4 group-hover:scale-110 transition-transform"
                >
                  <svg
                    class="w-8 h-8 text-white"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Instagram</h3>
                <p class="text-gray-400 text-sm mb-3">
                  Respuesta rápida y seguimiento
                </p>
                <span
                  class="text-cyan-500 font-semibold group-hover:text-pink-400 transition-colors"
                >
                  @abx_studio →
                </span>
              </a>

              <!-- TikTok -->
              <a
                href="https://www.tiktok.com/@abx_studio"
                target="_blank"
                rel="noopener noreferrer"
                class="group bg-black/40 hover:bg-cyan-500/10 p-8 rounded-2xl border border-gray-800 hover:border-cyan-500 transition-all duration-300 transform hover:scale-105"
              >
                <div
                  class="bg-cyan-500 p-4 rounded-xl inline-block mb-4 group-hover:scale-110 transition-transform"
                >
                  <svg
                    class="w-8 h-8 text-black"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.9-.32-1.98-.23-2.8.12-.9.38-1.45 1.24-1.61 2.18-.01.51.02 1.03.04 1.54.31 1.26 1.53 2.16 2.82 2.12 1.05-.02 2.01-.61 2.48-1.56.24-.41.35-.88.38-1.35.01-3.39-.01-6.79.01-10.19z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">TikTok</h3>
                <p class="text-gray-400 text-sm mb-3">
                  Tips y tutoriales musicales
                </p>
                <span
                  class="text-cyan-500 font-semibold group-hover:text-cyan-400 transition-colors"
                >
                  @abx_studio →
                </span>
              </a>

              <!-- YouTube -->
              <a
                href="https://www.youtube.com/@abx_studio"
                target="_blank"
                rel="noopener noreferrer"
                class="group bg-black/40 hover:bg-red-500/10 p-8 rounded-2xl border border-gray-800 hover:border-red-500 transition-all duration-300 transform hover:scale-105"
              >
                <div
                  class="bg-red-500 p-4 rounded-xl inline-block mb-4 group-hover:scale-110 transition-transform"
                >
                  <svg
                    class="w-8 h-8 text-white"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">YouTube</h3>
                <p class="text-gray-400 text-sm mb-3">
                  Videos completos y tutoriales
                </p>
                <span
                  class="text-cyan-500 font-semibold group-hover:text-red-400 transition-colors"
                >
                  @abx_studio →
                </span>
              </a>
            </div>

            <div
              class="mt-8 flex items-center justify-center gap-2 text-gray-400"
            >
              <svg
                class="w-5 h-5 text-green-400"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-sm">Respondemos en menos de 24 horas </span>
            </div>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-12 items-start">
          <!-- Email Form - Secondary Option -->
          <div
            class="bg-gray-900/30 backdrop-blur-sm rounded-2xl p-8 border border-gray-800"
          >
            <div class="flex items-center gap-3 mb-6">
              <div class="bg-cyan-500/20 p-2 rounded-lg">
                <svg
                  class="w-6 h-6 text-cyan-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-white">
                O contáctanos por email
              </h2>
            </div>
            <p class="text-gray-400 mb-6">
              Si prefieres una vía más formal, puedes escribirnos por correo.
              Nuestro equipo revisará tu mensaje y te responderá lo antes
              posible.
            </p>
            <form
              id="contactForm"
              action="https://formsubmit.co/contactoabxstudio@gmail.com"
              method="POST"
              class="space-y-5"
            >
              <input type="text" name="_honey" style="display:none" />
              <input type="hidden" name="_captcha" value="false" />
              <input
                type="hidden"
                name="_subject"
                value="Nuevo contacto desde ABX Studio Web"
              />

              <div>
                <label
                  for="name"
                  class="block text-sm font-medium text-gray-300 mb-2"
                >
                  Nombre
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 bg-black/50 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors"
                  placeholder="Tu nombre"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="block text-sm font-medium text-gray-300 mb-2"
                >
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 bg-black/50 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors"
                  placeholder="tu@email.com"
                />
              </div>

              <div>
                <label
                  for="service"
                  class="block text-sm font-medium text-gray-300 mb-2"
                >
                  Servicio de interés
                </label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-3 bg-black/50 border border-gray-700 rounded-lg text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors"
                >
                  <option value="Producción Musical">Producción Musical</option>
                  <option value="Mezcla y Masterización"
                    >Mezcla y Masterización</option
                  >
                  <option value="Composición">Composición</option>
                  <option value="Grabación">Grabación</option>
                  <option value="Beats y Instrumentales"
                    >Beats y Instrumentales</option
                  >
                  <option value="Otro">Otro</option>
                </select>
              </div>

              <div>
                <label
                  for="message"
                  class="block text-sm font-medium text-gray-300 mb-2"
                >
                  Mensaje
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="4"
                  class="w-full px-4 py-3 bg-black/50 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors resize-none"
                  placeholder="Cuéntanos sobre tu proyecto: género musical, referencias, idea general y tiempos aproximados.
"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full bg-cyan-500 hover:bg-cyan-600 text-black font-semibold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 flex items-center justify-center gap-2"
              >
                <span>Enviar Email</span>
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>
            </form>
          </div>

          <!-- Info Sidebar -->
          <div class="space-y-6">
            <!-- Quick Info -->
            <div
              class="bg-gray-900/30 backdrop-blur-sm rounded-2xl p-8 border border-gray-800"
            >
              <h3 class="text-xl font-bold text-white mb-6">
                Información Rápida
              </h3>
              <div class="space-y-5">
                <div class="flex items-start space-x-4">
                  <div class="bg-cyan-500/10 p-3 rounded-lg shrink-0">
                    <svg
                      class="w-6 h-6 text-cyan-500"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-white font-semibold mb-1">Email</h4>
                    <a
                      href="mailto:contactoabxstudio@gmail.com"
                      class="text-cyan-500 hover:text-cyan-400 transition-colors"
                    >
                      contactoabxstudio@gmail.com
                    </a>
                  </div>
                </div>

                <div class="flex items-start space-x-4">
                  <div class="bg-cyan-500/10 p-3 rounded-lg shrink-0">
                    <svg
                      class="w-6 h-6 text-cyan-500"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-white font-semibold mb-1">Horario</h4>
                    <p class="text-gray-400">Lun - Sáb: 10:00 AM - 10:00 PM</p>
                    <p class="text-gray-400 text-sm">
                      Zona horaria: BOT (GMT-4)
                    </p>
                  </div>
                </div>

                <div class="flex items-start space-x-4">
                  <div class="bg-cyan-500/10 p-3 rounded-lg shrink-0">
                    <svg
                      class="w-6 h-6 text-cyan-500"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                      ></path>
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-white font-semibold mb-1">Ubicación</h4>
                    <p class="text-gray-400">
                      Santa Cruz de la Sierra, Bolivia
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- FAQ Card -->
            <div
              class="bg-linear-to-br from-purple-500/10 to-cyan-500/10 backdrop-blur-sm rounded-2xl p-8 border border-purple-500/30"
            >
              <h3 class="text-xl font-bold text-white mb-4">
                ¿Por qué recomendamos contactarnos por DM?
              </h3>
              <ul class="space-y-3 text-gray-300">
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-cyan-500 shrink-0 mt-0.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>Respuesta más rápida por parte del equipo</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-cyan-500 shrink-0 mt-0.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>Posibilidad de enviar referencias, demos y enlaces</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-cyan-500 shrink-0 mt-0.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span
                    >Comunicación más fluida durante el proceso creativo</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-cyan-500 shrink-0 mt-0.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>Es el canal donde estamos más activos como estudio</span
                  >
                </li>
              </ul>
            </div>
            <div
              class="bg-transparent backdrop-blur-sm rounded-2xl justify-center items-center flex"
            >
              <FlipCtaCard
                class:list={"w-full"}
                title="¿Proyecto urgente?"
                description="Para proyectos con tiempos ajustados o consultas rápidas, Instagram DM es la forma más rápida de comenzar."
                ctaText="Enviar DM ahora"
                href="https://www.instagram.com/abx_studio"
              >
                <Flashsolid slot="icon" class="h-6 w-6 text-black" />
              </FlipCtaCard>
            </div>
          </div>
        </div>
      </div>
      
    </main>
    <div class="flex-none z-50">
      <Footer transition:persist />
    </div>

    <div class="flex-none z-50"></div>
  </div>

  <script src="https://animatedicons.co/scripts/embed-animated-icons.js"
  ></script>
</Layout>
