---
interface Props {
  artista: string;
  cancion: string;
  imagen?: string;
  link: string;
  soundcloudUrl: string;
  tags: string[];
  index?: number;
}

const {
  artista,
  cancion,
  imagen,
  link,
  soundcloudUrl,
  tags,
  index = 0,
} = Astro.props;
---

<div
  class="track-card group relative overflow-hidden rounded-2xl bg-neutral-900/80 border border-white/5 hover:border-cyan-400/50 p-6 flex items-center gap-6 transition-all duration-500 hover:shadow-2xl hover:shadow-cyan-400/10 hover:scale-[1.02]"
  style={`animation-delay: ${index * 0.1}s;`}
  data-soundcloud={soundcloudUrl}
>
  <div
    class="absolute inset-0 bg-linear-to-r from-cyan-400/0 via-cyan-400/5 to-cyan-400/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
  >
  </div>

  <div
    class="relative w-28 h-28 shrink-0 overflow-hidden rounded-xl bg-neutral-800 shadow-lg group-hover:scale-105 transition-transform duration-500"
  >
    {
      imagen ? (
        <img
          src={imagen}
          alt={cancion}
          class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity duration-500"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center bg-cyan-950/20">
          <svg
            class="w-12 h-12 text-cyan-400/80"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
          </svg>
        </div>
      )
    }
    <div
      class="loading-overlay absolute inset-0 bg-black/60 flex items-center justify-center opacity-0 transition-opacity"
    >
      <div
        class="w-8 h-8 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin"
      >
      </div>
    </div>
  </div>

  <div class="flex-1 relative z-10">
    <div class="flex gap-2 mb-3 flex-wrap">
      {
        tags.map((tag) => (
          <span class="text-[10px] md:text-xs text-cyan-400 bg-cyan-400/10 border border-cyan-400/30 px-3 py-1 rounded-full uppercase font-semibold">
            {tag}
          </span>
        ))
      }
    </div>
    <h4
      class="text-white font-bold text-lg md:text-xl mb-1 group-hover:text-cyan-400 transition-colors"
    >
      {cancion}
    </h4>
    <p class="text-gray-400 text-sm mb-4">{artista}</p>

    <a
      href={link}
      target="_blank"
      class="inline-flex items-center gap-2 text-xs font-bold text-cyan-400 hover:text-white transition-colors group/link"
    >
      <span>DETALLES</span>
      <svg
        class="w-4 h-4 group-hover/link:translate-x-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>
  </div>

  <button
    class="play-trigger absolute top-4 right-4 w-12 h-12 bg-cyan-400 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-0 group-hover:scale-100 shadow-lg shadow-cyan-400/50 hover:bg-white active:scale-90 z-30 cursor-pointer"
    aria-label="Reproducir track"
  >
    <svg
      class="play-icon w-6 h-6 text-black block group-[.is-playing]:hidden"
      fill="currentColor"
      viewBox="0 0 24 24"
    >
      <path d="M8 5v14l11-7z"></path>
    </svg>

    <svg
      class="pause-icon w-6 h-6 text-black hidden group-[.is-playing]:block"
      fill="currentColor"
      viewBox="0 0 24 24"
    >
      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
    </svg>
  </button>
</div>

<style>
  .track-card {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Estado cuando el audio está cargando */
  .is-loading .loading-overlay {
    opacity: 1;
  }
  .is-loading .play-icon,
  .is-loading .pause-icon {
    display: none !important;
  }

  /* Si está sonando, mantenemos el botón visible incluso si no hay hover */
  .track-card.is-playing {
    border-color: rgba(34, 211, 238, 0.5);
    transform: scale(1.02);
  }

  .is-playing .play-trigger {
    opacity: 1;
    transform: scale(1);
  }
</style>
